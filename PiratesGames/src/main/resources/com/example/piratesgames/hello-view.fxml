<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Spinner?>
<?import java.lang.Integer?>
<?import javafx.scene.control.SpinnerValueFactory?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<ScrollPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.piratesgames.PiratesGamesController"
            fitToWidth="true"
            pannable="true">

    <content>
        <HBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

    <!-- LEWA KOLUMNA -->
    <VBox spacing="10" prefWidth="380">
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.geometry.*?>
        <?import javafx.collections.*?>

        <VBox spacing="10" prefWidth="380">

            <!-- 1) GAME PARAMETERS -->
            <TitledPane text="Game parameters" expanded="true">
                <content>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- K, M, N -->
                        <Label text="K (#boats)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="kSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="200" initialValue="16"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="M (#rows)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Spinner fx:id="mSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="4"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="N (#cols)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Spinner fx:id="nSpinner" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="4"/>
                            </valueFactory>
                        </Spinner>

                        <!-- coins, steps, games -->
                        <Label text="C (#coins)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Spinner fx:id="coinsSpinner" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="q_step (#quant step)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Spinner fx:id="qStepSpinner" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000" initialValue="10"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="T (#games)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Spinner fx:id="gamesSpinner" GridPane.rowIndex="5" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000000" initialValue="10"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="del_T (#agree/win)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Spinner fx:id="delTSpinner" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000" initialValue="6"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="del_t (#del iter)" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Spinner fx:id="delSmallTSpinner" GridPane.rowIndex="7" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000" initialValue="2"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>
                </content>
            </TitledPane>
            <!-- 2) LIFE AWARENESS -->
            <TitledPane text="Life awareness" expanded="true">
                <content>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="single_game_cost" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="singleGameCostSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="1"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="initial_credit" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Spinner fx:id="initialCreditSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="20"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>
                </content>
            </TitledPane>

            <!-- 3) PROB. BOSS EXECUTION -->
            <TitledPane text="Prob. boss execution" expanded="true">
                <content>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="from" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="bossExecFromField" text="0.6" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="to" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="bossExecToField" text="1.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="step" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="bossExecStepField" text="0.1" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                </content>
            </TitledPane>
        </VBox>

        <!-- 4) COMPETITION + MUTATION -->
        <TitledPane text="Competition / Genetic operators" expanded="true">
            <content>
                <VBox spacing="10">
                    <!-- Competition on/off -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Competition"/>
                        <CheckBox fx:id="competitionOnCheckBox" text="on"/>
                    </HBox>

                    <!-- Selection method -->
                    <VBox spacing="6">
                        <Label text="Selection method"/>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <RadioButton fx:id="tournamentRadio" text="tournament"/>
                            <RadioButton fx:id="wheelRouletteRadio" text="wheel roulette"/>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <!-- Operators -->
                    <VBox spacing="6">
                        <CheckBox fx:id="crossoverCheckBox" text="crossover"/>
                        <CheckBox fx:id="mutationCheckBox" text="mutation"/>
                    </VBox>

                    <!-- Mutation ranges -->
                    <TitledPane text="Mutation parameters" expanded="true">
                        <content>
                            <GridPane hgap="8" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                </columnConstraints>

                                <Label text="" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label text="from" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="to" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <Label text="step" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                                <!-- prob_H_mut -->
                                <Label text="prob_H_mut" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="hMutFromField" text="0.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <TextField fx:id="hMutToField" text="0.5" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="hMutStepField" text="0.1" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                                <!-- prob_P_mut -->
                                <Label text="prob_P_mut" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="pMutFromField" text="0.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                <TextField fx:id="pMutToField" text="0.3" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                <TextField fx:id="pMutStepField" text="0.1" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                                <!-- prob_V_mut -->
                                <Label text="prob_V_mut" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <TextField fx:id="vMutFromField" text="0.0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                <TextField fx:id="vMutToField" text="0.5" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                                <TextField fx:id="vMutStepField" text="0.1" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                            </GridPane>
                        </content>
                    </TitledPane>
                </VBox>
            </content>
        </TitledPane>
        <!-- 5) GAUSSIAN NOISE + FAIRNESS FLOOR -->
        <TitledPane text="Noise / Fairness floor" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- Gaussian noise -->
                    <TitledPane text="Prob. Gaussian noise" expanded="true">
                        <content>
                            <GridPane hgap="8" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="from" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="gaussianFromField" text="0"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="to" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="gaussianToField" text="0"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                        </content>
                    </TitledPane>

                    <!-- Fairness floor -->
                    <TitledPane text="Fairness floor" expanded="true">
                        <content>
                            <GridPane hgap="8" vgap="6">
                                <columnConstraints>
                                    <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="from" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="fairnessFromField" text="5"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="to" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="fairnessToField" text="20"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>
                        </content>
                    </TitledPane>

                </VBox>
            </content>
        </TitledPane>

    </VBox>

    <!-- ŚRODKOWA KOLUMNA -->
    <VBox spacing="10" prefWidth="420">
        <!-- METRICS OF FAIRNESS -->
        <TitledPane text="Metrics of fairness" expanded="true">
            <content>
                <GridPane hgap="8" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints halignment="LEFT" minWidth="220"/>
                        <ColumnConstraints halignment="RIGHT" minWidth="80"/>
                    </columnConstraints>

                    <!-- Header -->
                    <Label text="Metric" style="-fx-font-weight: bold;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label text="Weight α" style="-fx-font-weight: bold;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- envy-freeness -->
                    <CheckBox fx:id="envyCheckBox" text="envy-freeness"
                              selected="true"
                              GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="envyWeightField" text="0.25"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- egalitarian -->
                    <CheckBox fx:id="egalitarianCheckBox" text="egalitarian"
                              selected="true"
                              GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="egalitarianWeightField" text="0.25"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- proportionality -->
                    <CheckBox fx:id="proportionalityCheckBox" text="proportionality"
                              GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="proportionalityWeightField" text="0"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- individual rationality -->
                    <CheckBox fx:id="individualRationalityCheckBox"
                              text="individual rationality"
                              GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="individualRationalityWeightField" text="0"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Pareto efficiency -->
                    <CheckBox fx:id="paretoCheckBox" text="Pareto efficiency"
                              selected="true"
                              GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="paretoWeightField" text="0.5"
                               GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <!-- utilitarian -->
                    <CheckBox fx:id="utilitarianCheckBox" text="utilitarian"
                              GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="utilitarianWeightField" text="0"
                               GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <!-- captain advantage -->
                    <CheckBox fx:id="captainAdvantageCheckBox"
                              text="captain advantage"
                              GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextField fx:id="captainAdvantageWeightField" text="0"
                               GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <!-- rank monotonicity violation -->
                    <CheckBox fx:id="rankMonoCheckBox"
                              text="rank monotonicity viol."
                              GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <TextField fx:id="rankMonoWeightField" text="0"
                               GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                    <!-- raw social welfare -->
                    <CheckBox fx:id="rawSocialCheckBox"
                              text="raw social welfare"
                              GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <TextField fx:id="rawSocialWeightField" text="0"
                               GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                </GridPane>
            </content>
        </TitledPane>
        <!-- RISK MODEL -->
        <TitledPane text="Risk model" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- prob. of surviving round -->
                    <VBox spacing="4">
                        <Label text="prob. of surviving round"/>
                        <GridPane hgap="6" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints minWidth="40"/>
                            </columnConstraints>

                            <TextField fx:id="survive1" text="0.9" GridPane.columnIndex="0"/>
                            <TextField fx:id="survive2" text="0.8" GridPane.columnIndex="1"/>
                            <TextField fx:id="survive3" text="0.7" GridPane.columnIndex="2"/>
                            <TextField fx:id="survive4" text="0.6" GridPane.columnIndex="3"/>
                            <TextField fx:id="survive5" text="0.5" GridPane.columnIndex="4"/>
                            <TextField fx:id="survive6" text="0.4" GridPane.columnIndex="5"/>
                            <TextField fx:id="survive7" text="0.3" GridPane.columnIndex="6"/>
                            <TextField fx:id="survive8" text="0.2" GridPane.columnIndex="7"/>
                            <TextField fx:id="survive9" text="0.2" GridPane.columnIndex="8"/>
                        </GridPane>
                    </VBox>

                    <!-- discounting factor δ -->
                    <VBox spacing="4">
                        <Label text="discounting factor δ"/>
                        <GridPane hgap="6" vgap="6">
                            <TextField fx:id="disc1" text="0.95" GridPane.columnIndex="0"/>
                            <TextField fx:id="disc2" text="0.55" GridPane.columnIndex="1"/>
                            <TextField fx:id="disc3" text="0.9"  GridPane.columnIndex="2"/>
                            <TextField fx:id="disc4" text="0.8"  GridPane.columnIndex="3"/>
                            <TextField fx:id="disc5" text="0.85" GridPane.columnIndex="4"/>
                            <TextField fx:id="disc6" text="0.85" GridPane.columnIndex="5"/>
                            <TextField fx:id="disc7" text="0.7"  GridPane.columnIndex="6"/>
                            <TextField fx:id="disc8" text="0.6"  GridPane.columnIndex="7"/>
                            <TextField fx:id="disc9" text="0.6"  GridPane.columnIndex="8"/>
                        </GridPane>
                    </VBox>

                    <!-- aversion to risk -->
                    <VBox spacing="4">
                        <Label text="aversion to risk"/>
                        <GridPane hgap="6" vgap="6">
                            <TextField fx:id="risk1" text="1.0" GridPane.columnIndex="0"/>
                            <TextField fx:id="risk2" text="0.9" GridPane.columnIndex="1"/>
                            <TextField fx:id="risk3" text="0.9" GridPane.columnIndex="2"/>
                            <TextField fx:id="risk4" text="0.8" GridPane.columnIndex="3"/>
                            <TextField fx:id="risk5" text="0.8" GridPane.columnIndex="4"/>
                            <TextField fx:id="risk6" text="0.8" GridPane.columnIndex="5"/>
                            <TextField fx:id="risk7" text="0.7" GridPane.columnIndex="6"/>
                            <TextField fx:id="risk8" text="0.7" GridPane.columnIndex="7"/>
                            <TextField fx:id="risk9" text="0.7" GridPane.columnIndex="8"/>
                        </GridPane>
                    </VBox>

                    <!-- grid gamma γ -->
                    <VBox spacing="4">
                        <Label text="grid gamma γ"/>
                        <GridPane hgap="6" vgap="6">
                            <TextField fx:id="gamma1" text="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="gamma2" text="1" GridPane.columnIndex="1"/>
                            <TextField fx:id="gamma3" text="1" GridPane.columnIndex="2"/>
                            <TextField fx:id="gamma4" text="1" GridPane.columnIndex="3"/>
                            <TextField fx:id="gamma5" text="1" GridPane.columnIndex="4"/>
                            <TextField fx:id="gamma6" text="1" GridPane.columnIndex="5"/>
                            <TextField fx:id="gamma7" text="1" GridPane.columnIndex="6"/>
                            <TextField fx:id="gamma8" text="1" GridPane.columnIndex="7"/>
                            <TextField fx:id="gamma9" text="1" GridPane.columnIndex="8"/>
                        </GridPane>
                    </VBox>

                    <!-- fairness sensitivity φ (simple range) -->
                    <!-- fairness sensitivity φ -->
                    <VBox spacing="4">
                        <Label text="fairness sensitivity φ"/>
                        <GridPane hgap="6" vgap="6">
                            <TextField fx:id="phi1" text="0.0" GridPane.columnIndex="0" prefColumnCount="3"/>
                            <TextField fx:id="phi2" text="0.1" GridPane.columnIndex="1" prefColumnCount="3"/>
                            <TextField fx:id="phi3" text="0.2" GridPane.columnIndex="2" prefColumnCount="3"/>
                            <TextField fx:id="phi4" text="0.3" GridPane.columnIndex="3" prefColumnCount="3"/>
                            <TextField fx:id="phi5" text="0.4" GridPane.columnIndex="4" prefColumnCount="3"/>
                            <TextField fx:id="phi6" text="0.5" GridPane.columnIndex="5" prefColumnCount="3"/>
                            <TextField fx:id="phi7" text="0.6" GridPane.columnIndex="6" prefColumnCount="3"/>
                            <TextField fx:id="phi8" text="0.7" GridPane.columnIndex="7" prefColumnCount="3"/>
                            <TextField fx:id="phi9" text="0.8" GridPane.columnIndex="8" prefColumnCount="3"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </content>
        </TitledPane>

        <!-- SEED / DEBUG / EXPERIMENTS -->
        <TitledPane text="Run settings" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- clock seed / custom -->
                    <VBox spacing="6">
                        <Label text="Seed"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <RadioButton fx:id="seedClockRadio" text="clock seed" selected="true"/>
                            <RadioButton fx:id="seedCustomRadio" text="custom"/>
                            <TextField fx:id="customSeedField" text="12345" prefColumnCount="8" disable="true"/>
                        </HBox>
                        <Label text="(Enable custom to type seed)" style="-fx-font-size: 10; -fx-opacity: 0.7;"/>
                    </VBox>

                    <Separator/>

                    <!-- debug tests -->
                    <VBox spacing="6">
                        <Label text="Debug"/>
                        <VBox spacing="4" style="-fx-padding: 0 0 0 8;">
                            <CheckBox fx:id="test1CheckBox" text="test_1"/>
                            <CheckBox fx:id="test2CheckBox" text="test_2"/>
                            <CheckBox fx:id="test3CheckBox" text="test_3"/>
                            <CheckBox fx:id="test4CheckBox" text="test_4"/>
                        </VBox>
                    </VBox>

                    <Separator/>

                    <!-- num of experiments -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="num of experiments" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="numExperimentsSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000000" initialValue="1"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                </VBox>
            </content>
        </TitledPane>

    </VBox>

    <!-- PRAWA KOLUMNA -->
    <VBox spacing="10" prefWidth="520">
        <!-- H ALGOS -->
        <TitledPane text="H algos" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- start / continuation -->
                    <!-- start (algorithm) / continuation (iterations) -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- START: algorithm -->
                        <Label text="start" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ChoiceBox fx:id="hStartChoice" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="H1 — random"/>
                                    <String fx:value="H2 — performance based reordering"/>
                                    <String fx:value="H3 — fixed stock hierarchy"/>
                                    <String fx:value="H4 — rotatory captain"/>
                                </FXCollections>
                            </items>
                        </ChoiceBox>

                        <!-- CONTINUATION: integer -->
                        <Label text="continuation" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Spinner fx:id="hContinuationSpinner"
                                 GridPane.rowIndex="0"
                                 GridPane.columnIndex="3">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory
                                        min="1" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                    <Separator/>
                    <!-- H list -->
                    <VBox spacing="6">
                        <CheckBox fx:id="h1CheckBox" text="H1 — random" selected="true"/>
                        <CheckBox fx:id="h2CheckBox" text="H2 — performance based reordering"/>
                        <CheckBox fx:id="h3CheckBox" text="H3 — fixed stock hierarchy" selected="true"/>
                        <CheckBox fx:id="h4CheckBox" text="H4 — rotatory captain" selected="true"/>
                    </VBox>
                </VBox>
            </content>
        </TitledPane>
        <!-- P ALGOS -->
        <TitledPane text="P algos" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- start / continuation (integers) -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="start" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="pStartSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
