    <VBox spacing="10" prefWidth="520">
        <!-- H ALGOS -->
        <TitledPane text="H algos" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- start / continuation -->
                    <!-- start (algorithm) / continuation (iterations) -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- START: algorithm -->
                        <Label text="start" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ChoiceBox fx:id="hStartChoice" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="H1 — random"/>
                                    <String fx:value="H2 — performance based reordering"/>
                                    <String fx:value="H3 — fixed stock hierarchy"/>
                                    <String fx:value="H4 — rotatory captain"/>
                                </FXCollections>
                            </items>
                        </ChoiceBox>

                        <!-- CONTINUATION: integer -->
                        <Label text="continuation" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Spinner editable="true" fx:id="hContinuationSpinner"
                                 GridPane.rowIndex="0"
                                 GridPane.columnIndex="3">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory
                                        min="1" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                    <Separator/>
                    <!-- H list -->
                    <VBox spacing="8">

                        <CheckBox fx:id="h1CheckBox" text="H1 — performance-based" selected="true"/>
                        <CheckBox fx:id="h2CheckBox" text="H2 — random shuffle" />
                        <CheckBox fx:id="h3CheckBox" text="H3 — rotatory captain" selected="true"/>
                        <CheckBox fx:id="h4CheckBox" text="H4 — fixed hierarchy" selected="true"/>
                        <CheckBox fx:id="h5CheckBox" text="H5 — hybrid"/>

                        <!-- H5 parameters -->
                        <GridPane hgap="8" vgap="6"
                                  visible="false" managed="false"
                                  fx:id="h5ParamsPane">
                            <columnConstraints>
                                <ColumnConstraints minWidth="70"/>
                                <ColumnConstraints minWidth="60"/>
                                <ColumnConstraints minWidth="70"/>
                                <ColumnConstraints minWidth="60"/>
                            </columnConstraints>

                            <Label text="pr_H1" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="prH1Field" text="0.0"
                                       prefColumnCount="4"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="pr_H2" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <TextField fx:id="prH2Field" text="0.20"
                                       prefColumnCount="4"
                                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                            <Label text="pr_H3" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="prH3Field" text="0.0"
                                       prefColumnCount="4"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="pr_H4" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            <TextField fx:id="prH4Field" text="0.80"
                                       prefColumnCount="4"
                                       GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        </GridPane>

                    </VBox>
                </VBox>
            </content>
        </TitledPane>
        <!-- P ALGOS -->
        <TitledPane text="P algos" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- start / continuation (integers) -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="start" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="pStartSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="continuation" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Spinner editable="true" fx:id="pContinuationSpinner" GridPane.rowIndex="0" GridPane.columnIndex="3">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                    <Separator/>

                    <!-- P list -->
                    <VBox spacing="6">
                        <CheckBox fx:id="p1CheckBox" text="P1 — egalitarian quantizer"/>
                        <CheckBox fx:id="p2CheckBox" text="P2 — one-shot rational equilibrium" selected="true"/>
                        <CheckBox fx:id="p3CheckBox" text="P3 — random constrained"/>
                        <CheckBox fx:id="p4CheckBox" text="P4 — local mutation of previous success" selected="true"/>
                    </VBox>

                </VBox>
            </content>
        </TitledPane>

        <!-- PR PROJECTION ALGOS -->
        <TitledPane text="PR projection algos" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- start / continuation (integers) -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="start" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="prStartSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="continuation" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Spinner editable="true" fx:id="prContinuationSpinner" GridPane.rowIndex="0" GridPane.columnIndex="3">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                    <Separator/>

                    <!-- PR list -->
                    <VBox spacing="6">
                        <CheckBox fx:id="pr1CheckBox" text="PR1 — increase payment for key players" selected="true"/>
                        <CheckBox fx:id="pr2CheckBox" text="PR2 — local mutation of previous PR"/>
                    </VBox>

                </VBox>
            </content>
        </TitledPane>
        <!-- V ALGOS -->
        <TitledPane text="V algos" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- start / continuation (integers) -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="110"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="start" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="vStartSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="continuation" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Spinner editable="true" fx:id="vContinuationSpinner" GridPane.rowIndex="0" GridPane.columnIndex="3">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                    <Separator/>

                    <!-- V list -->
                    <VBox spacing="6">
                        <CheckBox fx:id="v1CheckBox" text="V1 — deterministic self-interest"/>
                        <CheckBox fx:id="v2CheckBox" text="V2 — threshold with fairness sensitivity"/>
                        <CheckBox fx:id="v3CheckBox" text="V3 — probabilistic logit"/>
                        <CheckBox fx:id="v4CheckBox" text="V4 — rule-based coalition mimic"/>

                        <!-- V5 with k range -->
                        <VBox spacing="4">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <CheckBox fx:id="v5CheckBox" text="V5 — KD" selected="true"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 20;">
                                <Label text="k from"/>
                                <Spinner editable="true" fx:id="v5KFromSpinner">
                                    <valueFactory>
                                        <SpinnerValueFactory.IntegerSpinnerValueFactory min="4" max="8" initialValue="0"/>
                                    </valueFactory>
                                </Spinner>
                                <Label text="to"/>
                                <Spinner editable="true" fx:id="v5KToSpinner">
                                    <valueFactory>
                                        <SpinnerValueFactory.IntegerSpinnerValueFactory min="4" max="8" initialValue="8"/>
                                    </valueFactory>
                                </Spinner>
                            </HBox>
                        </VBox>

                        <!-- V6 with k range -->
                        <VBox spacing="4">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <CheckBox fx:id="v6CheckBox" text="V6 — KDC" selected="true"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 20;">
                                <Label text="k from"/>
                                <Spinner editable="true" fx:id="v6KFromSpinner">
                                    <valueFactory>
                                        <SpinnerValueFactory.IntegerSpinnerValueFactory min="4" max="8" initialValue="0"/>
                                    </valueFactory>
                                </Spinner>
                                <Label text="to"/>
                                <Spinner editable="true" fx:id="v6KToSpinner">
                                    <valueFactory>
                                        <SpinnerValueFactory.IntegerSpinnerValueFactory min="4" max="8" initialValue="8"/>
                                    </valueFactory>
                                </Spinner>
                            </HBox>
                        </VBox>

                    </VBox>

                </VBox>
            </content>
        </TitledPane>

        <!-- ACTION BUTTONS -->
        <VBox spacing="12" alignment="CENTER">
            <Separator/>

<!--            <Button fx:id="gotoLifeAwarenessButton"-->
<!--                    text="GOTO life awareness page"-->
<!--                    prefWidth="260"/>-->

            <Button fx:id="startButton"
                    text="START"
                    prefWidth="180"
                    style="-fx-font-size: 16; -fx-font-weight: bold;"
                    onAction="#onStartClicked"/>

            <Button text="Save config" onAction="#onSaveConfigClicked"/>

            <Label fx:id="resultLabel" text="-" />
        </VBox>
    </VBox>

    </HBox>
    </content>
</ScrollPane>