<?import javafx.scene.control.ScrollPane?>
<ScrollPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.piratesgames.PiratesGamesController"
            fitToWidth="true"
            pannable="true">

    <content>
        <HBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

    <!-- LEWA KOLUMNA -->
    <VBox spacing="10" prefWidth="380">
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.geometry.*?>
        <?import javafx.collections.*?>

        <VBox spacing="10" prefWidth="380">

            <!-- 1) GAME PARAMETERS -->
            <TitledPane text="Game parameters" expanded="true">
                <content>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- K, M, N -->
                        <Label text="K (#boats)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="kSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="200" initialValue="16"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="M (#rows)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="mSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="4"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="N (#cols)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="nSpinner" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="50" initialValue="4"/>
                            </valueFactory>
                        </Spinner>

                        <!-- coins, steps, games -->
                        <Label text="C (#coins)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="coinsSpinner" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="100"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="q_step (#quant step)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="qStepSpinner" GridPane.rowIndex="4" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000" initialValue="1"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="T (#games)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="gamesSpinner" GridPane.rowIndex="5" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000000" initialValue="50"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="del_T (#agree/win)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="delTSpinner" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000" initialValue="6"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="del_t (#del iter)" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="delSmallTSpinner" GridPane.rowIndex="7" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="1000" initialValue="2"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>
                </content>
            </TitledPane>
            <!-- 2) LIFE AWARENESS -->
            <TitledPane text="Life awareness" expanded="true">
                <content>
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="single_game_cost" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="singleGameCostSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="1"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="initial_credit" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="initialCreditSpinner" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100000" initialValue="20"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>
                </content>
            </TitledPane>


        </VBox>

        <!-- 4) COMPETITION + MUTATION -->
        <TitledPane text="Competition" expanded="true">
            <content>
                <VBox spacing="10">


                    <!-- Selection method -->
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <RadioButton fx:id="tournamentRadio" text="tournament"/>
                        <RadioButton fx:id="wheelRouletteRadio" text="wheel"/>
                    </HBox>

                    <Separator/>

                    <!-- Crossover -->
                    <VBox spacing="6">
                        <GridPane hgap="8" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                            </columnConstraints>

                            <Label text="cross-prob" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label text="from" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="to" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Label text="step" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                            <TextField fx:id="crossoverNameField" text="0.0"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="crossoverFromField" text="0.50"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <TextField fx:id="crossoverToField" text="0.80"
                                       GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            <TextField fx:id="crossoverStepField" text="0.10"
                                       GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        </GridPane>
                    </VBox>

                    <Separator/>

                    <!-- Mutation -->
                    <VBox spacing="6">
                        <GridPane hgap="8" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="40"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="70"/>
                            </columnConstraints>

                            <Label text="" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label text="prob_mut" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="from" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Label text="to" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                            <Label text="step" GridPane.rowIndex="0" GridPane.columnIndex="4"/>

                            <!-- H -->
                            <Label text="H" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="hMutNameField" text="0.0"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <TextField fx:id="hMutFromField" text="0.0"
                                       GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            <TextField fx:id="hMutToField" text="0.5"
                                       GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                            <TextField fx:id="hMutStepField" text="0.1"
                                       GridPane.rowIndex="1" GridPane.columnIndex="4"/>

                            <!-- P -->
                            <Label text="P" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="pMutNameField" text="0.0"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <TextField fx:id="pMutFromField" text="0.0"
                                       GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                            <TextField fx:id="pMutToField" text="0.3"
                                       GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                            <TextField fx:id="pMutStepField" text="0.1"
                                       GridPane.rowIndex="2" GridPane.columnIndex="4"/>

                            <!-- PR -->
                            <Label text="PR" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="prMutNameField" text="0.0"
                                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <TextField fx:id="prMutFromField" text="0.0"
                                       GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                            <TextField fx:id="prMutToField" text="0.3"
                                       GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                            <TextField fx:id="prMutStepField" text="0.1"
                                       GridPane.rowIndex="3" GridPane.columnIndex="4"/>

                            <!-- V -->
                            <Label text="V" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="vMutNameField" text="0.0"
                                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <TextField fx:id="vMutFromField" text="0.0"
                                       GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                            <TextField fx:id="vMutToField" text="0.5"
                                       GridPane.rowIndex="4" GridPane.columnIndex="3"/>
                            <TextField fx:id="vMutStepField" text="0.1"
                                       GridPane.rowIndex="4" GridPane.columnIndex="4"/>
                        </GridPane>
                    </VBox>

                </VBox>
            </content>
        </TitledPane>


        <!-- SEED / DEBUG / EXPERIMENTS -->
        <TitledPane text="Run settings" expanded="true">
            <content>
                <VBox spacing="10">

                    <!-- clock seed / custom -->
                    <VBox spacing="6">
                        <Label text="Seed"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <RadioButton fx:id="seedClockRadio" text="clock seed" selected="true"/>
                            <RadioButton fx:id="seedCustomRadio" text="custom"/>
                            <TextField fx:id="customSeedField" text="12345" prefColumnCount="8" disable="true"/>
                        </HBox>
                        <Label text="(Enable custom to type seed)" style="-fx-font-size: 10; -fx-opacity: 0.7;"/>
                    </VBox>

                    <Separator/>

                    <!-- debug tests -->
                    <VBox spacing="6">
                        <Label text="Debug"/>
                        <VBox spacing="4" style="-fx-padding: 0 0 0 8;">
                            <CheckBox fx:id="test1CheckBox" text="test_1"/>
                            <CheckBox fx:id="test2CheckBox" text="test_2"/>
                            <CheckBox fx:id="test3CheckBox" text="test_3"/>
                            <CheckBox fx:id="test4CheckBox" text="test_4"/>
                        </VBox>
                    </VBox>

                    <Separator/>

                    <!-- num of experiments -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="num of experiments" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner editable="true" fx:id="numExperimentsSpinner" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="1000000" initialValue="1"/>
                            </valueFactory>
                        </Spinner>
                    </GridPane>

                </VBox>
            </content>
        </TitledPane>
    </VBox>

